# Get a key at https://aistudio.google.com/apikey
# (new keys start with "AQ." -- that is normal; they need the google-genai SDK)
GEMINI_API_KEY=paste_your_key_here

# Optional: force a specific Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: store Hugging Face downloads on another drive
# HF_HOME=D:\huggingface_cache

# Optional: set to 1 if your GPU has 8 GB VRAM or less
# LOW_VRAM=1
